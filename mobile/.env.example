# Copia este archivo a mobile/.env y completa los valores con el responsable de Firebase.
# Nunca subas mobile/.env a GitHub.
#
# Obligatorias para autenticación Firebase (correo y Google Sign-In):

EXPO_PUBLIC_FIREBASE_API_KEY=
EXPO_PUBLIC_FIREBASE_AUTH_DOMAIN=
EXPO_PUBLIC_FIREBASE_PROJECT_ID=
EXPO_PUBLIC_FIREBASE_APP_ID=
EXPO_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
EXPO_PUBLIC_GOOGLE_WEB_CLIENT_ID=

# Opcionales (tienen fallback en el código; solo define si el equipo lo requiere):
# EXPO_PUBLIC_FIREBASE_STORAGE_BUCKET=
# EXPO_PUBLIC_API_URL=
